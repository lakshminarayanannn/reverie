{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "/home/you/.local/share/reverie/claude-code/reverie_hook.py",
              "session-start",
              "--memory",
              "/home/you/agent-memory"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "/home/you/.local/share/reverie/claude-code/reverie_hook.py",
              "pre-tool-use",
              "--memory",
              "/home/you/agent-memory"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "/home/you/.local/share/reverie/claude-code/reverie_hook.py",
              "post-tool-use",
              "--memory",
              "/home/you/agent-memory"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "/home/you/.local/share/reverie/claude-code/reverie_hook.py",
              "capture",
              "--memory",
              "/home/you/agent-memory"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "/home/you/.local/share/reverie/claude-code/reverie_hook.py",
              "capture",
              "--memory",
              "/home/you/agent-memory"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
